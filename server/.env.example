MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# JWT Secret Key for Admin Authentication
JWT_SECRET=super_secret_jwt_key_sahadat_portfolio_2026_xyz

# Nodemailer / Gmail SMTP Configuration
